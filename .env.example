# CodeAI Tutor - Ing. MOJICA
# Variables de Entorno - Copiar a .env y completar los valores

# ── LLM principal (OpenRouter) ──────────────────────────────────────
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui
OPENROUTER_MODEL=xiaomi/mimo-v2.5

# ── Gemini AI (fallback del LLM) ────────────────────────────────────
GEMINI_API_KEY=tu_gemini_api_key_aqui

# ── Pinecone (RAG / base de conocimiento) ───────────────────────────
PINECONE_API_KEY=tu_pinecone_api_key_aqui

# ── Supabase (Base de datos) ───────────────────────────────────────
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_anon_key_aqui

# ── TTS (voz en español para el Ing. MOJICA) ──────────────────────
# Opciones:
#   es-MX-JorgeNeural   (M, México)   - default (acento latino)
#   es-MX-DaliaNeural   (F, México)
#   es-CO-GonzaloNeural (M, Colombia)
#   es-CO-SalomeNeural  (F, Colombia)
#   es-AR-TomasNeural   (M, Argentina)
#   es-AR-ElenaNeural   (F, Argentina)
#   es-ES-AlvaroNeural  (M, España)
#   es-ES-ElviraNeural  (F, España)
TTS_VOICE=es-MX-JorgeNeural

# ── Servidor ───────────────────────────────────────────────────────
PORT=5000

# ── Seguridad ──────────────────────────────────────────────────────
SECRET_KEY=cambia-esta-clave-en-produccion-2026

# EnglishAI Tutor - Variables de Entorno
# Copiar a .env y completar los valores

# ── LLM principal (OpenRouter / MiMo V2.5) ─────────────────────────
LLM_PROVIDER=openrouter
LLM_MODEL=xiaomi/mimo-v2.5
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui
OPENROUTER_MODEL=xiaomi/mimo-v2.5

# ── Gemini AI (fallback) ─────────────────────────────────────────────
GEMINI_API_KEY=tu_gemini_api_key_aqui

# ── Pinecone (RAG) ──────────────────────────────────────────────────
PINECONE_API_KEY=tu_pinecone_api_key_aqui

# ── Supabase (Base de datos) ────────────────────────────────────────
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_anon_key_aqui

# ── TTS (voz en inglés para el profesor) ───────────────────────────
# Opciones: en-US-GuyNeural, en-US-JennyNeural, en-GB-RyanNeural, en-GB-SoniaNeural
TTS_VOICE=en-US-GuyNeural

# ── Servidor ────────────────────────────────────────────────────────
PORT=5000

# ── Seguridad ──────────────────────────────────────────────────────
SECRET_KEY=englishai-tutor-secret-change-in-production-2026
